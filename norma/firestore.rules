rules_version = '2';

// Правила доступу до бази «Норми».
//
// Хто що бачить:
//  • кожен, хто ввійшов (Google або пошта з паролем), — лише СВІЙ профіль і свої дні;
//  • адміністратор (його пошта є в колекції admins і підтверджена — вхід через Google) — профілі
//    й дні всіх працівників; може закрити працівнику доступ і додавати інших адміністраторів;
//  • без входу — нічого.
//
// Головного адміністратора підставляє публікація (GitHub → Settings → Variables → ADMIN_EMAIL)
// замість __OWNER_EMAIL__ нижче — щоб пошта не лежала у відкритому коді. Інших адміністраторів
// головний додає прямо в застосунку (колекція admins).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() {
      return request.auth.token.get('email', '') is string ? request.auth.token.get('email', '').lower() : '';
    }
    function isOwner() { return myEmail() == '__OWNER_EMAIL__'; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && myEmail() != ''
        && (isOwner() || exists(/databases/$(database)/documents/admins/$(myEmail())));
    }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function profile(uid) { return /databases/$(database)/documents/users/$(uid); }
    function blocked(uid) { return exists(profile(uid)) && get(profile(uid)).data.get('blocked', false) == true; }

    // ---------- Профіль: users/{uid} ----------
    // Поля, які пише сам працівник; blocked* — лише адміністратор.
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'email', 'createdAt', 'lastSeen', 'seenDay', 'blocked', 'blockedAt', 'blockedBy'])
        && d.get('name', '') is string && d.get('name', '').size() <= 80
        && d.get('email', '') is string && d.get('email', '').size() <= 200
        && d.get('seenDay', '') is string && d.get('seenDay', '').size() <= 10;
    }
    function sameBlock(d, old) {
      return d.get('blocked', false) == old.get('blocked', false)
        && d.get('blockedAt', null) == old.get('blockedAt', null)
        && d.get('blockedBy', null) == old.get('blockedBy', null);
    }
    match /users/{uid} {
      allow get: if isMe(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isMe(uid)
        && validProfile(request.resource.data)
        && !('blocked' in request.resource.data)
        && !('blockedAt' in request.resource.data)
        && !('blockedBy' in request.resource.data);
      allow update: if validProfile(request.resource.data) && (
        (isMe(uid) && sameBlock(request.resource.data, resource.data))
        || (isAdmin() && !isMe(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked', 'blockedAt', 'blockedBy']))
      );
      allow delete: if false;

      // ---------- Дані калькулятора: users/{uid}/calc/{settings | m-РРРР-ММ} ----------
      function validCalc(id, d) {
        return (id == 'settings' && d.get('kind', '') == 'settings')
          || (id.matches('m-[0-9]{4}-[0-9]{2}')
              && d.get('kind', '') == 'month'
              && d.get('month', '') is string
              && id == 'm-' + d.get('month', '')
              && d.get('days', {}) is map
              && d.get('deleted', {}) is map);
      }
      match /calc/{id} {
        allow read: if isMe(uid) || isAdmin();
        allow create, update: if isMe(uid) && !blocked(uid) && validCalc(id, request.resource.data);
        allow delete: if isMe(uid) && !blocked(uid);
      }
    }

    // ---------- Адміністратори: admins/{пошта} ----------
    match /admins/{email} {
      allow get: if signedIn() && (email == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && email == email.lower()
        && email.matches('[^@\\s/]+@[^@\\s/]+[.][^@\\s/]+')
        && request.resource.data.keys().hasOnly(['addedBy', 'addedAt', 'name']);
      // себе прибрати не можна — щоб випадково не залишитись без адміністратора
      allow delete: if isAdmin() && email != myEmail();
    }
  }
}
